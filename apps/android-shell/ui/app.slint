import { ScrollView } from "std-widgets.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import {
    ActionSheet,
    ActionRow,
    Card,
    IconButton,
} from "@origiri-mobile/widgets.slint";
import {
    Tokens,
    TabInfo,
    SuggestionInfo,
    BookmarkItem,
    HistoryItem,
    MenuRow,
    BrowserLogic,
    Webview,
    WebviewLogic,
} from "@nitium_shell";

component TabCard inherits Rectangle {
    in property <TabInfo> info;
    callback select();
    callback close();

    property <string> label: root.info.title != "" ? root.info.title : (root.info.url != "" ? root.info.url : "New Tab");

    height: 84px;
    border-radius: Tokens.corner-radius + 6px;
    border-width: root.info.active ? 2px : 1px;
    border-color: root.info.active ? Tokens.accent : Tokens.border-on-surface;
    background: root.info.active ? Tokens.surface-raised : Tokens.surface;

    touch := TouchArea {
        clicked => { root.select(); }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Rectangle {
                width: 18px;
                height: 18px;
                Icon {
                    width: 18px;
                    height: 18px;
                    source: root.info.loading ? TablerIcons.refresh : TablerIcons.world;
                    color: root.info.active ? Tokens.accent : Tokens.text-secondary;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.label;
                font-size: Tokens.font-size-normal;
                font-weight: root.info.active ? 600 : 400;
                color: root.info.active ? Tokens.text-primary : Tokens.text-secondary;
                overflow: elide;
                vertical-alignment: center;
            }

            // Close button inside card
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: close-touch.pressed ? Tokens.text-primary.with-alpha(0.12) : transparent;

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 18px;
                    height: 18px;
                    source: TablerIcons.x;
                    color: Tokens.text-secondary;
                }

                close-touch := TouchArea {
                    clicked => { root.close(); }
                }
            }
        }

        Text {
            text: root.info.url != "" ? root.info.url : "about:blank";
            font-size: Tokens.font-size-small;
            color: Tokens.text-disabled-on-surface;
            overflow: elide;
        }
    }
}

component TabOverview inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    callback close();
    callback new-tab();

    background: Tokens.background;

    VerticalLayout {
        // Header with safe-area
        Rectangle {
            height: root.inset-top + Metrics.top-bar-height;
            background: Tokens.surface;

            VerticalLayout {
                padding-top: root.inset-top;

                HorizontalLayout {
                    height: Metrics.top-bar-height;
                    padding-left: 16px;
                    padding-right: 8px;
                    alignment: center;

                    Text {
                        horizontal-stretch: 1;
                        text: "\{BrowserLogic.tabs.length} tabs";
                        font-size: 18px;
                        font-weight: 600;
                        color: Tokens.text-primary;
                        vertical-alignment: center;
                    }

                    IconButton {
                        icon: TablerIcons.plus;
                        tint: Tokens.text-primary;
                        clicked => { root.new-tab(); }
                    }

                    IconButton {
                        icon: TablerIcons.check;
                        tint: Tokens.accent;
                        clicked => { root.close(); }
                    }
                }
            }
        }

        // Tab list
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                padding-bottom: root.inset-bottom + 16px;
                spacing: 12px;
                for tab in BrowserLogic.tabs: TabCard {
                    info: tab;
                    select => {
                        BrowserLogic.select-tab(tab.id);
                        root.close();
                    }
                    close => {
                        BrowserLogic.close-tab(tab.id);
                    }
                }
            }
        }
    }
}

component AddressBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    /// Up/Down in the field: -1 or +1.
    callback move-selection(int);

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    height: 40px;
    border-radius: 20px;
    border-width: input.has-focus ? 1.5px : Tokens.border-width;
    border-color: input.has-focus ? Tokens.accent : (touch.has-hover ? Tokens.border-hover-on-surface : Tokens.border-on-surface);
    background: Tokens.background;
    animate border-color { duration: Tokens.anim-very-short * 1ms; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { root.focus-and-select(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                source: TablerIcons.search;
                color: Tokens.text-secondary;
            }
        }

        input := TextInput {
            horizontal-stretch: 1;
            color: Tokens.text-primary;
            font-size: Tokens.font-size-normal;
            vertical-alignment: center;
            single-line: true;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    root.move-selection(1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-selection(-1);
                    return accept;
                }
                reject
            }
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 14px + 16px + 8px;
        text: "Search or enter address";
        color: Tokens.text-disabled-on-surface;
        font-size: Tokens.font-size-normal;
        vertical-alignment: center;
    }
}

component MobileTopBar inherits Rectangle {
    in property <length> inset-top: 0px;
    in-out property <string> address-text <=> address-bar.text;
    out property <bool> address-has-focus: address-bar.has-focus;
    callback reload();

    public function focus-address() {
        address-bar.focus-and-select();
    }

    height: root.inset-top + Metrics.top-bar-height;
    background: Tokens.surface;

    VerticalLayout {
        padding-top: root.inset-top;

        HorizontalLayout {
            height: Metrics.top-bar-height;
            padding-left: 12px;
            padding-right: 8px;
            spacing: 8px;
            alignment: center;

            address-bar := AddressBar {
                horizontal-stretch: 1;
                text <=> BrowserLogic.address;
                accepted(text) => {
                    if BrowserLogic.suggestion-index >= 0 && BrowserLogic.suggestion-index < BrowserLogic.suggestions.length {
                        BrowserLogic.navigate(BrowserLogic.suggestions[BrowserLogic.suggestion-index].url);
                    } else {
                        BrowserLogic.navigate(text);
                    }
                }
                edited(text) => { BrowserLogic.address-edited(text); }
                move-selection(delta) => {
                    BrowserLogic.suggestion-index = max(-1, min(BrowserLogic.suggestions.length - 1, BrowserLogic.suggestion-index + delta));
                }
            }

            IconButton {
                icon: BrowserLogic.loading ? TablerIcons.x : TablerIcons.refresh;
                tint: Tokens.text-primary;
                clicked => { root.reload(); }
            }
        }
    }
}

component MobileBottomBar inherits Rectangle {
    in property <length> inset-bottom: 0px;
    callback open-tabs();
    callback open-menu();

    height: root.inset-bottom + Metrics.bottom-bar-height;
    background: Tokens.surface;

    // Top border separator for bottom bar
    Rectangle {
        y: 0px;
        width: 100%;
        height: 1px;
        background: Tokens.border-on-surface;
    }

    VerticalLayout {
        padding-bottom: root.inset-bottom;

        HorizontalLayout {
            height: Metrics.bottom-bar-height;
            alignment: space-around;

            IconButton {
                icon: TablerIcons.arrow-left;
                tint: Tokens.text-primary;
                enabled: BrowserLogic.can-go-back;
                clicked => { BrowserLogic.back(); }
            }

            IconButton {
                icon: TablerIcons.arrow-right;
                tint: Tokens.text-primary;
                enabled: BrowserLogic.can-go-forward;
                clicked => { BrowserLogic.forward(); }
            }

            IconButton {
                icon: TablerIcons.plus;
                tint: Tokens.text-primary;
                clicked => { BrowserLogic.new-tab(); }
            }

            // Tab Switcher button (48px touch target)
            Rectangle {
                width: Metrics.touch;
                height: 100%;

                tab-touch := TouchArea {
                    clicked => { root.open-tabs(); }
                }

                // Touch circle highlight
                Rectangle {
                    width: Metrics.touch;
                    height: Metrics.touch;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: tab-touch.pressed ? Tokens.text-primary.with-alpha(0.14) : transparent;

                    // Tab count rounded badge/box
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        border-width: 2px;
                        border-color: Tokens.text-primary;

                        Text {
                            text: "\{BrowserLogic.tabs.length}";
                            font-size: 12px;
                            font-weight: 700;
                            color: Tokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            IconButton {
                icon: TablerIcons.dots-vertical;
                tint: Tokens.text-primary;
                clicked => { root.open-menu(); }
            }
        }
    }
}

component MobileMenuSheet inherits ActionSheet {
    title: "Menu";

    ActionRow {
        text: "New Tab";
        clicked => {
            root.cancel();
            BrowserLogic.new-tab();
        }
    }

    ActionRow {
        text: BrowserLogic.bookmarked ? "Remove Bookmark" : "Add Bookmark";
        clicked => {
            root.cancel();
            BrowserLogic.toggle-bookmark();
        }
    }

    ActionRow {
        text: "Bookmarks";
        clicked => {
            root.cancel();
            BrowserLogic.open-bookmarks();
        }
    }

    ActionRow {
        text: "History";
        clicked => {
            root.cancel();
            BrowserLogic.open-history();
        }
    }

    ActionRow {
        text: "Find in Page";
        clicked => {
            root.cancel();
            BrowserLogic.find-open = true;
        }
    }

    ActionRow {
        text: "Settings";
        clicked => {
            root.cancel();
            BrowserLogic.open-settings();
        }
    }
}


/// The find-in-page strip: query field, match counter, previous/next, close.
component FindBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> status;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback next();
    callback previous();
    callback close();

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    background: Tokens.surface;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;
        alignment: center;

        Rectangle {
            horizontal-stretch: 1;
            height: 36px;
            border-radius: 18px;
            border-width: input.has-focus ? 1.5px : Tokens.border-width;
            border-color: input.has-focus ? Tokens.accent : Tokens.border-on-surface;
            background: Tokens.background;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;

                input := TextInput {
                    color: Tokens.text-primary;
                    font-size: Tokens.font-size-normal;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { root.edited(self.text); }
                    key-pressed(event) => {
                        if event.text == Key.Return {
                            if event.modifiers.shift {
                                root.previous();
                            } else {
                                root.next();
                            }
                            return accept;
                        }
                        reject
                    }
                }
            }

            if input.text == "" && !input.has-focus: Text {
                x: 12px;
                text: "Find in page";
                color: Tokens.text-disabled-on-surface;
                font-size: Tokens.font-size-normal;
                vertical-alignment: center;
            }
        }

        if root.status != "": Text {
            horizontal-stretch: 0;
            text: root.status;
            color: Tokens.text-secondary;
            font-size: Tokens.font-size-small;
            vertical-alignment: center;
        }

        IconButton {
            icon: TablerIcons.chevron-up;
            tint: Tokens.text-primary;
            clicked => { root.previous(); }
        }
        IconButton {
            icon: TablerIcons.chevron-down;
            tint: Tokens.text-primary;
            clicked => { root.next(); }
        }
        IconButton {
            icon: TablerIcons.x;
            tint: Tokens.text-primary;
            clicked => { root.close(); }
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();

    height: 32px;
    min-width: 84px;
    border-radius: Tokens.corner-radius + 2px;
    background: root.primary ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) : (touch.has-hover ? Tokens.hover-on-raised : Tokens.surface);
    border-width: root.primary ? 0px : Tokens.border-width;
    border-color: Tokens.border-on-raised;
    animate background { duration: Tokens.anim-very-short * 1ms; }

    Text {
        text: root.text;
        color: root.primary ? Tokens.text-on-accent : Tokens.text-primary;
        font-size: Tokens.font-size-normal;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DialogField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    callback accepted();

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    height: 32px;
    border-radius: Tokens.corner-radius + 2px;
    border-width: input.has-focus ? 1.5px : Tokens.border-width;
    border-color: input.has-focus ? Tokens.accent : Tokens.border-on-raised;
    background: Tokens.background;

    HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-medium;

        input := TextInput {
            color: Tokens.text-primary;
            font-size: Tokens.font-size-normal;
            vertical-alignment: center;
            single-line: true;
            input-type: root.input-type;
            accepted => { root.accepted(); }
        }
    }

    if root.text == "" && root.placeholder != "" && !input.has-focus: Text {
        x: Tokens.spacing-medium;
        text: root.placeholder;
        color: Tokens.text-disabled-on-surface;
        font-size: Tokens.font-size-normal;
        vertical-alignment: center;
    }
}

/// Modal question from the page. Dims everything and takes the keyboard.
component DialogLayer inherits Rectangle {
    background: #000000a0;

    property <int> kind: BrowserLogic.dialog-kind;
    property <bool> asks-text: root.kind == 2 || root.kind == 4;

    /// Puts the cursor where the user will type, or on the dialog itself.
    public function focus-first() {
        if root.asks-text {
            first-field.focus-and-select();
        } else {
            keys.focus();
        }
    }

    // Swallows every click so nothing behind the dialog can be reached.
    TouchArea { }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                BrowserLogic.dialog-cancel();
                return accept;
            }
            if event.text == Key.Return {
                BrowserLogic.dialog-accept();
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(440px, parent.width - 32px);
            height: card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(16px, (parent.height - self.height) / 3);
            background: Tokens.surface-raised;
            border-radius: Tokens.corner-radius + 4px;
            border-width: Tokens.border-width;
            border-color: Tokens.border-on-raised;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 8px;

            card := VerticalLayout {
                padding: Tokens.spacing-large;
                spacing: Tokens.spacing-medium;

                Text {
                    text: BrowserLogic.dialog-title;
                    color: Tokens.text-primary;
                    font-size: Tokens.font-size-large;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: BrowserLogic.dialog-message;
                    color: Tokens.text-secondary-on-raised;
                    font-size: Tokens.font-size-normal;
                    wrap: word-wrap;
                    max-height: 240px;
                    overflow: elide;
                }

                first-field := DialogField {
                    visible: root.asks-text;
                    height: root.asks-text ? 32px : 0px;
                    text <=> BrowserLogic.dialog-input;
                    placeholder: root.kind == 4 ? "User name" : "";
                    accepted => { BrowserLogic.dialog-accept(); }
                }

                if root.kind == 4: DialogField {
                    text <=> BrowserLogic.dialog-password;
                    placeholder: "Password";
                    input-type: InputType.password;
                    accepted => { BrowserLogic.dialog-accept(); }
                }

                HorizontalLayout {
                    spacing: Tokens.spacing-medium;
                    alignment: end;

                    if root.kind != 0: DialogButton {
                        text: root.kind == 3 ? "Deny" : "Cancel";
                        clicked => { BrowserLogic.dialog-cancel(); }
                    }
                    DialogButton {
                        primary: true;
                        text: root.kind == 3 ? "Allow" : (root.kind == 4 ? "Sign in" : "OK");
                        clicked => { BrowserLogic.dialog-accept(); }
                    }
                }
            }
        }
    }
}

/// Context menu / `<select>` list. A click anywhere outside dismisses it.
component MenuLayer inherits Rectangle {
    /// Where the page area starts in the window; menu positions are relative to it.
    in property <length> origin-x;
    in property <length> origin-y;

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                BrowserLogic.menu-dismiss();
            }
        }
    }

    Rectangle {
        width: min(max(BrowserLogic.menu-width, 180px), root.width - 8px);
        height: min(BrowserLogic.menu-height, root.height - 8px);
        x: max(4px, min(root.origin-x + BrowserLogic.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.origin-y + BrowserLogic.menu-y, root.height - self.height - 4px));
        background: Tokens.surface-raised;
        border-radius: Tokens.corner-radius + 2px;
        border-width: Tokens.border-width;
        border-color: Tokens.border-on-raised;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 4px;
        clip: true;

        Flickable {
            list := VerticalLayout {
                padding: 4px;

                for row[i] in BrowserLogic.menu-rows: Rectangle {
                    height: row.separator ? 9px : 28px;

                    if row.separator: Rectangle {
                        x: 8px;
                        y: 4px;
                        width: parent.width - 16px;
                        height: 1px;
                        background: Tokens.divider-on-raised;
                    }

                    if !row.separator: Rectangle {
                        border-radius: Tokens.corner-radius;
                        background: (row.enabled && !row.heading && row-touch.has-hover) ? Tokens.hover-on-raised : transparent;

                        if row.checked: Icon {
                            x: 6px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            source: TablerIcons.check;
                            color: Tokens.accent;
                        }

                        Text {
                            x: row.indented ? 26px : 24px;
                            width: parent.width - self.x - 8px;
                            height: parent.height;
                            text: row.label;
                            color: row.heading ? Tokens.text-secondary-on-raised : (row.enabled ? Tokens.text-primary : Tokens.text-disabled-on-raised);
                            font-size: Tokens.font-size-small;
                            font-weight: row.heading ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        row-touch := TouchArea {
                            enabled: row.enabled && !row.heading;
                            mouse-cursor: pointer;
                            clicked => { BrowserLogic.menu-activate(i); }
                        }
                    }
                }
            }
        }
    }
}

/// Thin indeterminate bar shown under the toolbar while a page loads.
component LoadingBar inherits Rectangle {
    height: 2px;
    clip: true;
    background: Tokens.accent-soft;

    Rectangle {
        width: parent.width * 0.3;
        height: parent.height;
        x: mod(animation-tick() / 1.1s, 1.0) * (parent.width * 1.3) - self.width;
        background: Tokens.accent;
    }
}

component SettingsButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> destructive: false;
    callback clicked <=> touch.clicked;

    height: 32px;
    border-radius: Tokens.corner-radius;
    background: root.active ? Tokens.accent-soft : (touch.has-hover ? (root.destructive ? #ff444433 : Tokens.hover-on-surface) : Tokens.surface);
    border-width: Tokens.border-width;
    border-color: root.active ? Tokens.accent : (root.destructive ? #ff444466 : Tokens.border-on-surface);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    Text {
        text: root.text;
        color: root.active ? Tokens.accent : (root.destructive ? #ff6666 : (touch.has-hover ? Tokens.text-primary : Tokens.text-secondary));
        font-size: Tokens.font-size-small;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SettingsColorButton inherits Rectangle {
    in property <color> swatch-color;
    in property <string> text;
    in property <bool> active: false;
    callback clicked <=> touch.clicked;

    height: 32px;
    border-radius: Tokens.corner-radius;
    background: root.active ? Tokens.accent-soft : (touch.has-hover ? Tokens.hover-on-surface : Tokens.surface);
    border-width: Tokens.border-width;
    border-color: root.active ? Tokens.accent : Tokens.border-on-surface;

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Tokens.spacing-small;
        padding-left: Tokens.spacing-small;
        padding-right: Tokens.spacing-small;

        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.swatch-color;
            border-width: 1px;
            border-color: #ffffff40;
        }

        Text {
            text: root.text;
            color: root.active ? Tokens.accent : (touch.has-hover ? Tokens.text-primary : Tokens.text-secondary);
            font-size: Tokens.font-size-small;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search...";
    callback edited(string);

    height: 32px;
    background: Tokens.surface;
    border-radius: Tokens.corner-radius;
    border-width: Tokens.border-width;
    border-color: input.has-focus ? Tokens.accent : Tokens.border-on-surface;

    HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-medium;
        spacing: Tokens.spacing-small;

        Icon {
            width: 14px;
            height: 14px;
            source: TablerIcons.search;
            color: Tokens.text-secondary;
        }

        input := TextInput {
            horizontal-stretch: 1;
            text <=> root.text;
            color: Tokens.text-primary;
            font-size: Tokens.font-size-small;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: Tokens.spacing-medium + 14px + Tokens.spacing-small;
        y: 0px;
        height: 100%;
        text: root.placeholder;
        color: Tokens.text-disabled-on-surface;
        font-size: Tokens.font-size-small;
        vertical-alignment: center;
    }
}

/// Modal settings overlay.
component SettingsLayer inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    background: Tokens.background;

    FocusScope {
        width: 100%;
        height: 100%;

        VerticalLayout {
            // Mobile Header
            Rectangle {
                height: root.inset-top + Metrics.top-bar-height;
                background: Tokens.surface;

                VerticalLayout {
                    padding-top: root.inset-top;

                    HorizontalLayout {
                        height: Metrics.top-bar-height;
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        IconButton {
                            icon: TablerIcons.arrow-left;
                            tint: Tokens.text-primary;
                            clicked => { BrowserLogic.close-settings(); }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "Settings";
                            color: Tokens.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        SettingsButton {
                            width: 80px;
                            text: "Save";
                            active: true;
                            clicked => {
                                BrowserLogic.save-settings(
                                    BrowserLogic.settings-home-url,
                                    BrowserLogic.settings-search-url,
                                    BrowserLogic.settings-restore-session,
                                    BrowserLogic.settings-theme,
                                    BrowserLogic.settings-theme-preset,
                                    BrowserLogic.settings-accent-color,
                                    BrowserLogic.settings-corner-radius,
                                );
                                BrowserLogic.close-settings();
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Tokens.border-on-surface;
            }

            VerticalLayout {
                padding: Tokens.spacing-large;
                spacing: Tokens.spacing-medium;


                Rectangle {
                    height: 1px;
                    background: Tokens.divider-on-raised;
                }

                // Scrollable content
                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Tokens.spacing-large;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        // Section 1: Search & Navigation
                        VerticalLayout {
                            spacing: Tokens.spacing-small;

                            Text {
                                text: "SEARCH ENGINE";
                                color: Tokens.accent;
                                font-size: Tokens.font-size-small;
                                font-weight: 600;
                            }

                            // Presets row 1
                            HorizontalLayout {
                                spacing: Tokens.spacing-small;
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Google";
                                    active: BrowserLogic.settings-search-preset == 0;
                                    clicked => { BrowserLogic.select-search-preset(0); }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "DuckDuckGo";
                                    active: BrowserLogic.settings-search-preset == 1;
                                    clicked => { BrowserLogic.select-search-preset(1); }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Bing";
                                    active: BrowserLogic.settings-search-preset == 2;
                                    clicked => { BrowserLogic.select-search-preset(2); }
                                }
                            }

                            // Presets row 2
                            HorizontalLayout {
                                spacing: Tokens.spacing-small;
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Brave";
                                    active: BrowserLogic.settings-search-preset == 3;
                                    clicked => { BrowserLogic.select-search-preset(3); }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Yahoo";
                                    active: BrowserLogic.settings-search-preset == 4;
                                    clicked => { BrowserLogic.select-search-preset(4); }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Ecosia";
                                    active: BrowserLogic.settings-search-preset == 5;
                                    clicked => { BrowserLogic.select-search-preset(5); }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Custom";
                                    active: BrowserLogic.settings-search-preset == 6;
                                    clicked => { BrowserLogic.select-search-preset(6); }
                                }
                            }

                            Text {
                                text: "Query URL (%s is replaced with search term):";
                                color: Tokens.text-secondary-on-raised;
                                font-size: Tokens.font-size-small;
                            }

                            DialogField {
                                text <=> BrowserLogic.settings-search-url;
                                placeholder: "https://example.com/search?q=%s";
                            }
                        }

                        // Section 2: Home Page & Startup
                        VerticalLayout {
                            spacing: Tokens.spacing-small;

                            Text {
                                text: "STARTUP & HOME PAGE";
                                color: Tokens.accent;
                                font-size: Tokens.font-size-small;
                                font-weight: 600;
                            }

                            Text {
                                text: "Home Page URL:";
                                color: Tokens.text-secondary-on-raised;
                                font-size: Tokens.font-size-small;
                            }

                            DialogField {
                                text <=> BrowserLogic.settings-home-url;
                                placeholder: "https://servo.org";
                            }

                            HorizontalLayout {
                                spacing: Tokens.spacing-medium;

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: BrowserLogic.settings-restore-session ? Tokens.accent : Tokens.surface;
                                    border-width: Tokens.border-width;
                                    border-color: Tokens.border-on-surface;

                                    if BrowserLogic.settings-restore-session: Icon {
                                        width: 14px;
                                        height: 14px;
                                        source: TablerIcons.check;
                                        color: #ffffff;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            BrowserLogic.settings-restore-session = !BrowserLogic.settings-restore-session;
                                        }
                                    }
                                }

                                Text {
                                    text: "Restore tabs from previous session on startup";
                                    color: Tokens.text-primary;
                                    font-size: Tokens.font-size-normal;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Section 3: Appearance & Theme
                        VerticalLayout {
                            spacing: Tokens.spacing-small;

                            Text {
                                text: "APPEARANCE & THEME";
                                color: Tokens.accent;
                                font-size: Tokens.font-size-small;
                                font-weight: 600;
                            }

                            Text {
                                text: "Palette Preset";
                                color: Tokens.text-secondary-on-raised;
                                font-size: Tokens.font-size-small;
                            }

                            HorizontalLayout {
                                spacing: Tokens.spacing-small;
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "System";
                                    active: BrowserLogic.settings-theme-preset == "system";
                                    clicked => { BrowserLogic.settings-theme-preset = "system"; }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Origiri Dark";
                                    active: BrowserLogic.settings-theme-preset == "dark";
                                    clicked => { BrowserLogic.settings-theme-preset = "dark"; }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Origiri Light";
                                    active: BrowserLogic.settings-theme-preset == "light";
                                    clicked => { BrowserLogic.settings-theme-preset = "light"; }
                                }
                            }

                            HorizontalLayout {
                                spacing: Tokens.spacing-small;
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Tokyo Night";
                                    active: BrowserLogic.settings-theme-preset == "tokyonight-night";
                                    clicked => { BrowserLogic.settings-theme-preset = "tokyonight-night"; }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Catppuccin";
                                    active: BrowserLogic.settings-theme-preset == "catppuccin-mocha";
                                    clicked => { BrowserLogic.settings-theme-preset = "catppuccin-mocha"; }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Flexoki";
                                    active: BrowserLogic.settings-theme-preset == "flexoki-dark";
                                    clicked => { BrowserLogic.settings-theme-preset = "flexoki-dark"; }
                                }
                            }

                            Text {
                                text: "Accent Color";
                                color: Tokens.text-secondary-on-raised;
                                font-size: Tokens.font-size-small;
                            }

                            HorizontalLayout {
                                spacing: Tokens.spacing-small;
                                SettingsColorButton {
                                    horizontal-stretch: 1;
                                    text: "Default";
                                    swatch-color: #d12a55;
                                    active: BrowserLogic.settings-accent-color == "default" || BrowserLogic.settings-accent-color == "";
                                    clicked => { BrowserLogic.settings-accent-color = "default"; }
                                }
                                SettingsColorButton {
                                    horizontal-stretch: 1;
                                    text: "Blue";
                                    swatch-color: #3b82f6;
                                    active: BrowserLogic.settings-accent-color == "#3b82f6";
                                    clicked => { BrowserLogic.settings-accent-color = "#3b82f6"; }
                                }
                                SettingsColorButton {
                                    horizontal-stretch: 1;
                                    text: "Emerald";
                                    swatch-color: #10b981;
                                    active: BrowserLogic.settings-accent-color == "#10b981";
                                    clicked => { BrowserLogic.settings-accent-color = "#10b981"; }
                                }
                                SettingsColorButton {
                                    horizontal-stretch: 1;
                                    text: "Purple";
                                    swatch-color: #8b5cf6;
                                    active: BrowserLogic.settings-accent-color == "#8b5cf6";
                                    clicked => { BrowserLogic.settings-accent-color = "#8b5cf6"; }
                                }
                                SettingsColorButton {
                                    horizontal-stretch: 1;
                                    text: "Orange";
                                    swatch-color: #f97316;
                                    active: BrowserLogic.settings-accent-color == "#f97316";
                                    clicked => { BrowserLogic.settings-accent-color = "#f97316"; }
                                }
                            }

                            Text {
                                text: "Corner Radius";
                                color: Tokens.text-secondary-on-raised;
                                font-size: Tokens.font-size-small;
                            }

                            HorizontalLayout {
                                spacing: Tokens.spacing-small;
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "None (0px)";
                                    active: BrowserLogic.settings-corner-radius == "disabled";
                                    clicked => { BrowserLogic.settings-corner-radius = "disabled"; }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Small (4px)";
                                    active: BrowserLogic.settings-corner-radius == "small" || BrowserLogic.settings-corner-radius == "";
                                    clicked => { BrowserLogic.settings-corner-radius = "small"; }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Medium (8px)";
                                    active: BrowserLogic.settings-corner-radius == "medium";
                                    clicked => { BrowserLogic.settings-corner-radius = "medium"; }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Large (14px)";
                                    active: BrowserLogic.settings-corner-radius == "large";
                                    clicked => { BrowserLogic.settings-corner-radius = "large"; }
                                }
                            }
                        }

                        // Section 4: Privacy & Browsing Data
                        VerticalLayout {
                            spacing: Tokens.spacing-small;

                            Text {
                                text: "PRIVACY & BROWSING DATA";
                                color: Tokens.accent;
                                font-size: Tokens.font-size-small;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: Tokens.spacing-small;

                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Clear History";
                                    clicked => { BrowserLogic.clear-history(); }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Clear Bookmarks";
                                    clicked => { BrowserLogic.clear-bookmarks(); }
                                }
                                SettingsButton {
                                    horizontal-stretch: 1;
                                    text: "Clear Cookies & Cache";
                                    destructive: true;
                                    clicked => { BrowserLogic.clear-browsing-data(); }
                                }
                            }
                        }

                        if BrowserLogic.settings-status != "": Text {
                            text: BrowserLogic.settings-status;
                            color: Tokens.accent;
                            font-size: Tokens.font-size-small;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Tokens.divider-on-raised;
                }

                // Footer actions
                HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.spacing-medium;

                    SettingsButton {
                        width: 100px;
                        text: "Cancel";
                        clicked => { BrowserLogic.close-settings(); }
                    }

                    SettingsButton {
                        width: 130px;
                        text: "Save & Close";
                        active: true;
                        clicked => {
                            BrowserLogic.save-settings(
                                BrowserLogic.settings-home-url,
                                BrowserLogic.settings-search-url,
                                BrowserLogic.settings-restore-session,
                                BrowserLogic.settings-theme,
                                BrowserLogic.settings-theme-preset,
                                BrowserLogic.settings-accent-color,
                                BrowserLogic.settings-corner-radius,
                            );
                            BrowserLogic.close-settings();
                        }
                    }
                }
            }
        }
    }
}

/// Modal bookmarks overlay.
component BookmarksLayer inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    background: Tokens.background;

    FocusScope {
        width: 100%;
        height: 100%;

        VerticalLayout {
            // Header
            Rectangle {
                height: root.inset-top + Metrics.top-bar-height;
                background: Tokens.surface;

                VerticalLayout {
                    padding-top: root.inset-top;

                    HorizontalLayout {
                        height: Metrics.top-bar-height;
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        IconButton {
                            icon: TablerIcons.arrow-left;
                            tint: Tokens.text-primary;
                            clicked => { BrowserLogic.close-bookmarks(); }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "Bookmarks";
                            color: Tokens.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Search filter
            Rectangle {
                height: 52px;
                background: Tokens.surface;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 8px;

                    SearchField {
                        horizontal-stretch: 1;
                        text <=> BrowserLogic.bookmarks-filter;
                        placeholder: "Search bookmarks...";
                        edited(query) => { BrowserLogic.filter-bookmarks(query); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Tokens.border-on-surface;
            }

            // List
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 8px;
                    padding-bottom: root.inset-bottom + 16px;
                    spacing: 4px;

                    for item in BrowserLogic.bookmarks-list: Rectangle {
                        height: 56px;
                        border-radius: Tokens.corner-radius + 2px;
                        background: row-touch.pressed ? Tokens.surface-raised : Tokens.surface;

                        row-touch := TouchArea {
                            clicked => {
                                BrowserLogic.open-bookmark(item.url);
                                BrowserLogic.close-bookmarks();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            spacing: 12px;
                            alignment: center;

                            Icon {
                                width: 18px;
                                height: 18px;
                                source: TablerIcons.star;
                                color: Tokens.accent;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: item.title != "" ? item.title : item.url;
                                    color: Tokens.text-primary;
                                    font-size: Tokens.font-size-normal;
                                    font-weight: 500;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.url;
                                    color: Tokens.text-secondary;
                                    font-size: Tokens.font-size-small;
                                    overflow: elide;
                                }
                            }

                            IconButton {
                                icon: TablerIcons.trash;
                                tint: Tokens.text-secondary;
                                clicked => { BrowserLogic.remove-bookmark(item.url); }
                            }
                        }
                    }

                    if BrowserLogic.bookmarks-list.length == 0: VerticalLayout {
                        alignment: center;
                        height: 160px;
                        Text {
                            text: "No bookmarks yet.";
                            color: Tokens.text-disabled-on-surface;
                            font-size: Tokens.font-size-normal;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}


/// Modal history overlay.
component HistoryLayer inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    background: Tokens.background;

    FocusScope {
        width: 100%;
        height: 100%;

        VerticalLayout {
            // Header
            Rectangle {
                height: root.inset-top + Metrics.top-bar-height;
                background: Tokens.surface;

                VerticalLayout {
                    padding-top: root.inset-top;

                    HorizontalLayout {
                        height: Metrics.top-bar-height;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        IconButton {
                            icon: TablerIcons.arrow-left;
                            tint: Tokens.text-primary;
                            clicked => { BrowserLogic.close-history(); }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "History";
                            color: Tokens.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        IconButton {
                            icon: TablerIcons.trash;
                            tint: Tokens.text-secondary;
                            clicked => { BrowserLogic.clear-all-history(); }
                        }
                    }
                }
            }

            // Search filter
            Rectangle {
                height: 52px;
                background: Tokens.surface;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 8px;

                    SearchField {
                        horizontal-stretch: 1;
                        text <=> BrowserLogic.history-filter;
                        placeholder: "Search history...";
                        edited(query) => { BrowserLogic.filter-history(query); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Tokens.border-on-surface;
            }

            // List
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 8px;
                    padding-bottom: root.inset-bottom + 16px;
                    spacing: 4px;

                    for item in BrowserLogic.history-list: Rectangle {
                        height: 58px;
                        border-radius: Tokens.corner-radius + 2px;
                        background: row-touch.pressed ? Tokens.surface-raised : Tokens.surface;

                        row-touch := TouchArea {
                            clicked => {
                                BrowserLogic.open-history-item(item.url);
                                BrowserLogic.close-history();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            spacing: 12px;
                            alignment: center;

                            Icon {
                                width: 18px;
                                height: 18px;
                                source: TablerIcons.clock;
                                color: Tokens.text-secondary;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: item.title != "" ? item.title : item.url;
                                    color: Tokens.text-primary;
                                    font-size: Tokens.font-size-normal;
                                    font-weight: 500;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.url;
                                    color: Tokens.text-secondary;
                                    font-size: Tokens.font-size-small;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: item.date-label;
                                color: Tokens.text-disabled-on-surface;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            IconButton {
                                icon: TablerIcons.trash;
                                tint: Tokens.text-secondary;
                                clicked => { BrowserLogic.remove-history-item(item.url); }
                            }
                        }
                    }

                    if BrowserLogic.history-list.length == 0: VerticalLayout {
                        alignment: center;
                        height: 160px;
                        Text {
                            text: "No history found.";
                            color: Tokens.text-disabled-on-surface;
                            font-size: Tokens.font-size-normal;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}


export component AppWindow inherits Window {
    title: BrowserLogic.window-title;
    preferred-width: 412px;
    preferred-height: 892px;
    min-width: 320px;
    min-height: 480px;
    background: Tokens.background;

    in-out property <bool> tabs-overview-open: false;
    in-out property <bool> mobile-menu-open: false;

    /// Focuses the address bar and selects its text.
    public function focus-address() {
        top-bar.focus-address();
    }

    /// Moves keyboard focus into the page.
    public function focus-content() {
        webview.focus-content();
    }

    /// Puts the cursor into the page dialog's first field (or on the dialog itself).
    public function focus-dialog() {
        dialog-layer.focus-first();
    }

    /// Focuses the find bar's query field and selects its text.
    public function focus-find() {
        find-bar.focus-and-select();
    }

    FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            if BrowserLogic.shortcut(event) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Mobile Top Bar (address bar + reload)
            top-bar := MobileTopBar {
                inset-top: root.safe-area-insets.top;
                reload => { BrowserLogic.reload(); }
            }

            // Loading indicator
            Rectangle {
                height: 2px;
                background: Tokens.surface;
                if BrowserLogic.loading: LoadingBar {}
            }

            // Find in page bar
            find-bar := FindBar {
                visible: BrowserLogic.find-open;
                height: BrowserLogic.find-open ? 48px : 0px;
                text <=> BrowserLogic.find-text;
                status: BrowserLogic.find-status;
                edited(text) => { BrowserLogic.find-changed(text); }
                next => { BrowserLogic.find-next(); }
                previous => { BrowserLogic.find-previous(); }
                close => { BrowserLogic.find-close(); }
            }

            // Webview
            webview := Webview {
                vertical-stretch: 1;
            }

            // Mobile Bottom Navigation Bar
            bottom-bar := MobileBottomBar {
                inset-bottom: root.safe-area-insets.bottom;
                open-tabs => { root.tabs-overview-open = true; }
                open-menu => { root.mobile-menu-open = true; }
            }
        }
    }

    // Address bar suggestions overlay
    if top-bar.address-has-focus && BrowserLogic.suggestions.length > 0: Rectangle {
        x: 8px;
        y: top-bar.height + 4px;
        width: parent.width - 16px;
        height: min(parent.height - top-bar.height - root.safe-area-insets.bottom - 20px, BrowserLogic.suggestions.length * 48px + 8px);
        background: Tokens.surface-raised;
        border-radius: Tokens.corner-radius + 4px;
        border-width: Tokens.border-width;
        border-color: Tokens.border-on-raised;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000088;
        drop-shadow-offset-y: 6px;

        ScrollView {
            VerticalLayout {
                padding: 4px;

                for suggestion[i] in BrowserLogic.suggestions: Rectangle {
                    height: 44px;
                    border-radius: Tokens.corner-radius;
                    background: i == BrowserLogic.suggestion-index ? Tokens.selected-on-raised : (row-touch.has-hover ? Tokens.hover-on-raised : transparent);

                    row-touch := TouchArea {
                        clicked => { BrowserLogic.navigate(suggestion.url); }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            Icon {
                                width: 16px;
                                height: 16px;
                                source: TablerIcons.search;
                                color: Tokens.text-secondary-on-raised;
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: suggestion.title;
                            color: Tokens.text-primary;
                            font-size: Tokens.font-size-normal;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: suggestion.url;
                            color: Tokens.text-secondary-on-raised;
                            font-size: Tokens.font-size-small;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // Tab Overview (Switcher)
    if root.tabs-overview-open: TabOverview {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        close => { root.tabs-overview-open = false; }
        new-tab => {
            BrowserLogic.new-tab();
            root.tabs-overview-open = false;
        }
    }

    // Mobile Menu Sheet
    menu-sheet := MobileMenuSheet {
        open: root.mobile-menu-open;
        inset-bottom: root.safe-area-insets.bottom;
        cancel => { root.mobile-menu-open = false; }
    }

    menu-layer := MenuLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: BrowserLogic.menu-visible;
        origin-x: webview.absolute-position.x;
        origin-y: webview.absolute-position.y;
    }

    dialog-layer := DialogLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: BrowserLogic.dialog-visible;
    }

    settings-layer := SettingsLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        visible: BrowserLogic.settings-open;
    }

    bookmarks-layer := BookmarksLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        visible: BrowserLogic.bookmarks-open;
    }

    history-layer := HistoryLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        visible: BrowserLogic.history-open;
    }

    changed address-has-focus => { BrowserLogic.address-focused = top-bar.address-has-focus; }
    property <bool> address-has-focus: top-bar.address-has-focus;
    changed find-has-focus => { BrowserLogic.find-focused = find-bar.has-focus; }
    property <bool> find-has-focus: find-bar.has-focus;
}
