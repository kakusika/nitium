import { Tokens } from "@origiri/tokens.slint";
import { IconButton } from "@origiri/widgets.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import { Webview, WebviewLogic } from "@webview/webview.slint";

export { WebviewLogic }

export struct TabInfo {
    id: int,
    title: string,
    url: string,
    loading: bool,
    active: bool,
    can-go-back: bool,
    can-go-forward: bool,
}

/// One row of the address bar drop-down.
export struct SuggestionInfo {
    title: string,
    url: string,
}

/// One row of the popup menu (a context menu or a `<select>` list).
export struct MenuRow {
    label: string,
    enabled: bool,
    separator: bool,
    checked: bool,
    /// A group heading: shown dimmed, not clickable.
    heading: bool,
    indented: bool,
}

/// Browser state owned by the application (tabs, address bar) and the user
/// intents the UI raises. The Rust side implements every callback.
export global BrowserLogic {
    in property <[TabInfo]> tabs;
    in property <string> window-title: "Nitium";
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> loading;
    /// Whether the active page is bookmarked.
    in property <bool> bookmarked;
    in-out property <string> address;
    in-out property <bool> address-focused;
    in property <[SuggestionInfo]> suggestions;
    /// Highlighted suggestion, or -1 when the user is just typing.
    in-out property <int> suggestion-index: -1;
    /// Page zoom in percent (100 = normal).
    in property <int> zoom-percent: 100;

    // Find in page.
    in-out property <bool> find-open;
    in-out property <string> find-text;
    in-out property <bool> find-focused;
    /// "3/12", "No matches", or empty.
    in property <string> find-status;
    // A question from the page (script dialog, permission, HTTP authentication).
    // kind: 0 alert, 1 confirm, 2 prompt, 3 permission, 4 authentication.
    in property <bool> dialog-visible;
    in property <int> dialog-kind;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in-out property <string> dialog-input;
    in-out property <string> dialog-password;
    callback dialog-accept();
    callback dialog-cancel();

    // The popup menu, positioned relative to the page area.
    in property <bool> menu-visible;
    in property <[MenuRow]> menu-rows;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width;
    in property <length> menu-height;
    callback menu-activate(int);
    callback menu-dismiss();

    callback find-changed(string);
    callback find-next();
    callback find-previous();
    callback find-close();
    callback reset-zoom();

    callback new-tab();
    callback toggle-bookmark();
    /// The user changed the address text (not raised for programmatic changes).
    callback address-edited(string);
    callback close-tab(int);
    callback select-tab(int);
    callback navigate(string);
    callback back();
    callback forward();
    callback reload();
    /// Returns true when the key press was an application shortcut and must
    /// not reach the page.
    callback shortcut(KeyEvent) -> bool;
}

component BrowserTab inherits Rectangle {
    in property <TabInfo> info;
    callback select();
    callback close();

    property <string> label: root.info.title != "" ? root.info.title : (root.info.url != "" ? root.info.url : "New Tab");

    height: 32px;
    border-top-left-radius: Tokens.corner-radius + 2px;
    border-top-right-radius: Tokens.corner-radius + 2px;
    background: root.info.active ? Tokens.surface : (touch.has-hover ? Tokens.hover : transparent);
    animate background { duration: Tokens.anim-very-short * 1ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.middle && event.kind == PointerEventKind.up {
                root.close();
            }
        }
    }

    HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-small;
        spacing: Tokens.spacing-small;

        Rectangle {
            width: 14px;
            Icon {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: root.info.loading ? TablerIcons.refresh : TablerIcons.world;
                color: root.info.active ? Tokens.accent : Tokens.text-secondary;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.info.active ? Tokens.text-primary : Tokens.text-secondary;
            font-size: Tokens.font-size-small;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 22px;
            IconButton {
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                icon-size: 12px;
                icon: TablerIcons.x;
                clicked => { root.close(); }
            }
        }
    }
}

component AddressBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    /// Up/Down in the field: -1 or +1.
    callback move-selection(int);

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    height: 30px;
    border-radius: Tokens.corner-radius + 2px;
    border-width: input.has-focus ? 1.5px : Tokens.border-width;
    border-color: input.has-focus ? Tokens.accent : (touch.has-hover ? Tokens.border-hover-on-surface : Tokens.border-on-surface);
    background: Tokens.background;
    animate border-color { duration: Tokens.anim-very-short * 1ms; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { root.focus-and-select(); }
    }

    HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-medium;
        spacing: Tokens.spacing-small;

        Rectangle {
            width: 14px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: TablerIcons.search;
                color: Tokens.text-secondary;
            }
        }

        input := TextInput {
            horizontal-stretch: 1;
            color: Tokens.text-primary;
            font-size: Tokens.font-size-normal;
            vertical-alignment: center;
            single-line: true;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    root.move-selection(1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-selection(-1);
                    return accept;
                }
                reject
            }
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: Tokens.spacing-medium + 14px + Tokens.spacing-small;
        text: "Search or enter address";
        color: Tokens.text-disabled-on-surface;
        font-size: Tokens.font-size-normal;
        vertical-alignment: center;
    }
}

/// The find-in-page strip: query field, match counter, previous/next, close.
component FindBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> status;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback next();
    callback previous();
    callback close();

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    background: Tokens.surface;

    HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-medium;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: Tokens.spacing-small;

        Rectangle {
            horizontal-stretch: 0;
            width: 260px;
            border-radius: Tokens.corner-radius + 2px;
            border-width: input.has-focus ? 1.5px : Tokens.border-width;
            border-color: input.has-focus ? Tokens.accent : Tokens.border-on-surface;
            background: Tokens.background;

            HorizontalLayout {
                padding-left: Tokens.spacing-medium;
                padding-right: Tokens.spacing-medium;

                input := TextInput {
                    color: Tokens.text-primary;
                    font-size: Tokens.font-size-normal;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { root.edited(self.text); }
                    key-pressed(event) => {
                        if event.text == Key.Return {
                            if event.modifiers.shift {
                                root.previous();
                            } else {
                                root.next();
                            }
                            return accept;
                        }
                        reject
                    }
                }
            }

            if input.text == "" && !input.has-focus: Text {
                x: Tokens.spacing-medium;
                text: "Find in page";
                color: Tokens.text-disabled-on-surface;
                font-size: Tokens.font-size-normal;
                vertical-alignment: center;
            }
        }

        Text {
            horizontal-stretch: 0;
            min-width: 70px;
            text: root.status;
            color: Tokens.text-secondary;
            font-size: Tokens.font-size-small;
            vertical-alignment: center;
        }

        IconButton {
            width: 28px;
            height: 28px;
            icon: TablerIcons.chevron-up;
            clicked => { root.previous(); }
        }
        IconButton {
            width: 28px;
            height: 28px;
            icon: TablerIcons.chevron-down;
            clicked => { root.next(); }
        }
        Rectangle { horizontal-stretch: 1; }
        IconButton {
            width: 28px;
            height: 28px;
            icon: TablerIcons.x;
            clicked => { root.close(); }
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();

    height: 32px;
    min-width: 84px;
    border-radius: Tokens.corner-radius + 2px;
    background: root.primary ? (touch.has-hover ? Tokens.accent-hover : Tokens.accent) : (touch.has-hover ? Tokens.hover-on-raised : Tokens.surface);
    border-width: root.primary ? 0px : Tokens.border-width;
    border-color: Tokens.border-on-raised;
    animate background { duration: Tokens.anim-very-short * 1ms; }

    Text {
        text: root.text;
        color: root.primary ? Tokens.text-on-accent : Tokens.text-primary;
        font-size: Tokens.font-size-normal;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DialogField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    callback accepted();

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    height: 32px;
    border-radius: Tokens.corner-radius + 2px;
    border-width: input.has-focus ? 1.5px : Tokens.border-width;
    border-color: input.has-focus ? Tokens.accent : Tokens.border-on-raised;
    background: Tokens.background;

    HorizontalLayout {
        padding-left: Tokens.spacing-medium;
        padding-right: Tokens.spacing-medium;

        input := TextInput {
            color: Tokens.text-primary;
            font-size: Tokens.font-size-normal;
            vertical-alignment: center;
            single-line: true;
            input-type: root.input-type;
            accepted => { root.accepted(); }
        }
    }

    if root.text == "" && root.placeholder != "" && !input.has-focus: Text {
        x: Tokens.spacing-medium;
        text: root.placeholder;
        color: Tokens.text-disabled-on-surface;
        font-size: Tokens.font-size-normal;
        vertical-alignment: center;
    }
}

/// Modal question from the page. Dims everything and takes the keyboard.
component DialogLayer inherits Rectangle {
    background: #000000a0;

    property <int> kind: BrowserLogic.dialog-kind;
    property <bool> asks-text: root.kind == 2 || root.kind == 4;

    /// Puts the cursor where the user will type, or on the dialog itself.
    public function focus-first() {
        if root.asks-text {
            first-field.focus-and-select();
        } else {
            keys.focus();
        }
    }

    // Swallows every click so nothing behind the dialog can be reached.
    TouchArea { }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                BrowserLogic.dialog-cancel();
                return accept;
            }
            if event.text == Key.Return {
                BrowserLogic.dialog-accept();
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(440px, parent.width - 32px);
            height: card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(16px, (parent.height - self.height) / 3);
            background: Tokens.surface-raised;
            border-radius: Tokens.corner-radius + 4px;
            border-width: Tokens.border-width;
            border-color: Tokens.border-on-raised;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 8px;

            card := VerticalLayout {
                padding: Tokens.spacing-large;
                spacing: Tokens.spacing-medium;

                Text {
                    text: BrowserLogic.dialog-title;
                    color: Tokens.text-primary;
                    font-size: Tokens.font-size-large;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: BrowserLogic.dialog-message;
                    color: Tokens.text-secondary-on-raised;
                    font-size: Tokens.font-size-normal;
                    wrap: word-wrap;
                    max-height: 240px;
                    overflow: elide;
                }

                first-field := DialogField {
                    visible: root.asks-text;
                    height: root.asks-text ? 32px : 0px;
                    text <=> BrowserLogic.dialog-input;
                    placeholder: root.kind == 4 ? "User name" : "";
                    accepted => { BrowserLogic.dialog-accept(); }
                }

                if root.kind == 4: DialogField {
                    text <=> BrowserLogic.dialog-password;
                    placeholder: "Password";
                    input-type: InputType.password;
                    accepted => { BrowserLogic.dialog-accept(); }
                }

                HorizontalLayout {
                    spacing: Tokens.spacing-medium;
                    alignment: end;

                    if root.kind != 0: DialogButton {
                        text: root.kind == 3 ? "Deny" : "Cancel";
                        clicked => { BrowserLogic.dialog-cancel(); }
                    }
                    DialogButton {
                        primary: true;
                        text: root.kind == 3 ? "Allow" : (root.kind == 4 ? "Sign in" : "OK");
                        clicked => { BrowserLogic.dialog-accept(); }
                    }
                }
            }
        }
    }
}

/// Context menu / `<select>` list. A click anywhere outside dismisses it.
component MenuLayer inherits Rectangle {
    /// Where the page area starts in the window; menu positions are relative to it.
    in property <length> origin-x;
    in property <length> origin-y;

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                BrowserLogic.menu-dismiss();
            }
        }
    }

    Rectangle {
        width: min(max(BrowserLogic.menu-width, 180px), root.width - 8px);
        height: min(BrowserLogic.menu-height, root.height - 8px);
        x: max(4px, min(root.origin-x + BrowserLogic.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.origin-y + BrowserLogic.menu-y, root.height - self.height - 4px));
        background: Tokens.surface-raised;
        border-radius: Tokens.corner-radius + 2px;
        border-width: Tokens.border-width;
        border-color: Tokens.border-on-raised;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 4px;
        clip: true;

        Flickable {
            list := VerticalLayout {
                padding: 4px;

                for row[i] in BrowserLogic.menu-rows: Rectangle {
                    height: row.separator ? 9px : 28px;

                    if row.separator: Rectangle {
                        x: 8px;
                        y: 4px;
                        width: parent.width - 16px;
                        height: 1px;
                        background: Tokens.divider-on-raised;
                    }

                    if !row.separator: Rectangle {
                        border-radius: Tokens.corner-radius;
                        background: (row.enabled && !row.heading && row-touch.has-hover) ? Tokens.hover-on-raised : transparent;

                        if row.checked: Icon {
                            x: 6px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            source: TablerIcons.check;
                            color: Tokens.accent;
                        }

                        Text {
                            x: row.indented ? 26px : 24px;
                            width: parent.width - self.x - 8px;
                            height: parent.height;
                            text: row.label;
                            color: row.heading ? Tokens.text-secondary-on-raised : (row.enabled ? Tokens.text-primary : Tokens.text-disabled-on-raised);
                            font-size: Tokens.font-size-small;
                            font-weight: row.heading ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        row-touch := TouchArea {
                            enabled: row.enabled && !row.heading;
                            mouse-cursor: pointer;
                            clicked => { BrowserLogic.menu-activate(i); }
                        }
                    }
                }
            }
        }
    }
}

/// Thin indeterminate bar shown under the toolbar while a page loads.
component LoadingBar inherits Rectangle {
    height: 2px;
    clip: true;
    background: Tokens.accent-soft;

    Rectangle {
        width: parent.width * 0.3;
        height: parent.height;
        x: mod(animation-tick() / 1.1s, 1.0) * (parent.width * 1.3) - self.width;
        background: Tokens.accent;
    }
}

export component AppWindow inherits Window {
    title: BrowserLogic.window-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 480px;
    min-height: 320px;
    background: Tokens.background;

    /// Focuses the address bar and selects its text (Ctrl+L).
    public function focus-address() {
        address.focus-and-select();
    }

    /// Moves keyboard focus into the page.
    public function focus-content() {
        webview.focus-content();
    }

    /// Puts the cursor into the page dialog's first field (or on the dialog itself).
    public function focus-dialog() {
        dialog-layer.focus-first();
    }

    /// Focuses the find bar's query field and selects its text (Ctrl+F).
    public function focus-find() {
        find-bar.focus-and-select();
    }

    FocusScope {
        width: 100%;
        height: 100%;

        // Shortcuts are decided before the focused element (address bar or
        // page) sees the key, so they work regardless of where focus is.
        capture-key-pressed(event) => {
            if BrowserLogic.shortcut(event) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Tab strip
            tab-strip := Rectangle {
                height: 36px;
                background: Tokens.background;

                HorizontalLayout {
                    padding-top: 4px;
                    padding-left: Tokens.spacing-small;
                    padding-right: Tokens.spacing-small;

                    // Tabs shrink from their preferred width down to a minimum as more are
                    // opened; the filler at the end absorbs any spare room.
                    for tab in BrowserLogic.tabs: BrowserTab {
                        preferred-width: 200px;
                        min-width: 72px;
                        max-width: 220px;
                        horizontal-stretch: 1;
                        info: tab;
                        select => { BrowserLogic.select-tab(tab.id); }
                        close => { BrowserLogic.close-tab(tab.id); }
                    }

                    Rectangle {
                        width: 34px;
                        horizontal-stretch: 0;
                        IconButton {
                            width: 28px;
                            height: 28px;
                            icon: TablerIcons.plus;
                            clicked => { BrowserLogic.new-tab(); }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1000;
                        min-width: 0px;
                    }
                }
            }

            // Toolbar
            Rectangle {
                height: 44px;
                background: Tokens.surface;

                HorizontalLayout {
                    padding-left: Tokens.spacing-medium;
                    padding-right: Tokens.spacing-medium;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: Tokens.spacing-small;

                    IconButton {
                        width: 30px;
                        height: 30px;
                        icon: TablerIcons.arrow-left;
                        enabled: BrowserLogic.can-go-back;
                        clicked => { BrowserLogic.back(); }
                    }
                    IconButton {
                        width: 30px;
                        height: 30px;
                        icon: TablerIcons.arrow-right;
                        enabled: BrowserLogic.can-go-forward;
                        clicked => { BrowserLogic.forward(); }
                    }
                    IconButton {
                        width: 30px;
                        height: 30px;
                        icon: TablerIcons.refresh;
                        clicked => { BrowserLogic.reload(); }
                    }

                    address := AddressBar {
                        horizontal-stretch: 1;
                        text <=> BrowserLogic.address;
                        accepted(text) => {
                            if BrowserLogic.suggestion-index >= 0 && BrowserLogic.suggestion-index < BrowserLogic.suggestions.length {
                                BrowserLogic.navigate(BrowserLogic.suggestions[BrowserLogic.suggestion-index].url);
                            } else {
                                BrowserLogic.navigate(text);
                            }
                        }
                        edited(text) => { BrowserLogic.address-edited(text); }
                        move-selection(delta) => {
                            BrowserLogic.suggestion-index = max(-1, min(BrowserLogic.suggestions.length - 1, BrowserLogic.suggestion-index + delta));
                        }
                    }

                    if BrowserLogic.zoom-percent != 100: Rectangle {
                        width: 56px;
                        border-radius: Tokens.corner-radius + 2px;
                        background: zoom-touch.has-hover ? Tokens.hover : Tokens.background;

                        Text {
                            text: "\{BrowserLogic.zoom-percent}%";
                            color: Tokens.text-secondary;
                            font-size: Tokens.font-size-small;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        zoom-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { BrowserLogic.reset-zoom(); }
                        }
                    }

                    IconButton {
                        width: 30px;
                        height: 30px;
                        icon: TablerIcons.star;
                        active: BrowserLogic.bookmarked;
                        clicked => { BrowserLogic.toggle-bookmark(); }
                    }
                }
            }

            Rectangle {
                height: 2px;
                background: Tokens.surface;
                if BrowserLogic.loading: LoadingBar {}
            }

            find-bar := FindBar {
                visible: BrowserLogic.find-open;
                height: BrowserLogic.find-open ? 38px : 0px;
                text <=> BrowserLogic.find-text;
                status: BrowserLogic.find-status;
                edited(text) => { BrowserLogic.find-changed(text); }
                next => { BrowserLogic.find-next(); }
                previous => { BrowserLogic.find-previous(); }
                close => { BrowserLogic.find-close(); }
            }

            webview := Webview {
                vertical-stretch: 1;
            }
        }
    }

    // Address bar suggestions, drawn last so they sit above the page.
    if address.has-focus && BrowserLogic.suggestions.length > 0: Rectangle {
        x: address.absolute-position.x;
        y: address.absolute-position.y + address.height + 2px;
        width: address.width;
        height: BrowserLogic.suggestions.length * 34px + 8px;
        background: Tokens.surface-raised;
        border-radius: Tokens.corner-radius + 2px;
        border-width: Tokens.border-width;
        border-color: Tokens.border-on-raised;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 4px;

        VerticalLayout {
            padding: 4px;

            for suggestion[i] in BrowserLogic.suggestions: Rectangle {
                height: 34px;
                border-radius: Tokens.corner-radius;
                background: i == BrowserLogic.suggestion-index ? Tokens.selected-on-raised : (row-touch.has-hover ? Tokens.hover-on-raised : transparent);

                row-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { BrowserLogic.navigate(suggestion.url); }
                }

                HorizontalLayout {
                    padding-left: Tokens.spacing-medium;
                    padding-right: Tokens.spacing-medium;
                    spacing: Tokens.spacing-medium;

                    Text {
                        horizontal-stretch: 1;
                        text: suggestion.title;
                        color: Tokens.text-primary;
                        font-size: Tokens.font-size-small;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        horizontal-stretch: 2;
                        text: suggestion.url;
                        color: Tokens.text-secondary-on-raised;
                        font-size: Tokens.font-size-small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    menu-layer := MenuLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: BrowserLogic.menu-visible;
        origin-x: webview.absolute-position.x;
        origin-y: webview.absolute-position.y;
    }

    dialog-layer := DialogLayer {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: BrowserLogic.dialog-visible;
    }

    changed address-has-focus => { BrowserLogic.address-focused = address.has-focus; }
    property <bool> address-has-focus: address.has-focus;
    changed find-has-focus => { BrowserLogic.find-focused = find-bar.has-focus; }
    property <bool> find-has-focus: find-bar.has-focus;
}
